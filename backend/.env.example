APP_NAME=AI-Powered Knowledge Base 
APP_VERSION=1.0.0
UPLOAD_DIR=data/uploads
VECTOR_STORE_DIR=data/vector_store

# Vector store provider: chromadb | sqlite
VECTOR_STORE_PROVIDER=chromadb
SQLITE_DB_PATH=data/knowledge_base.db

# Fully offline mode (true/false). When true, embeddings must load from local path.
OFFLINE_MODE=false

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_LOCAL_PATH=models/paraphrase-multilingual-MiniLM-L12-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=10

# LLM provider: openrouter | foundry_local
LLM_PROVIDER=openrouter

# OpenRouter (cloud) settings — used when LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700

# Foundry Local (on-device) settings — used when LLM_PROVIDER=foundry_local
# No API key is required for Foundry Local.
FOUNDRY_MODEL_ALIAS=qwen2.5-0.5b

RAG_TOP_K=5
MIN_SIMILARITY_SCORE=0.25
